        default_layer {
            bindings = <
                &lt 6 ESC  &mt LALT Q  &kp W  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp MINUS  &kp LALT  &mt LSHFT TAB  &kp A  &kp E  &kp F  &kp G  &kp H  &kp J  &kp K  &lt 4 L  &kp P  &kp ENTER  &kp LCTRL  &kp S  &kp D  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp FSLH  &kp DOT  &kp TAB  &kp Z  &kp X  &kp C  &lt 2 INT5  &lt 3 SPACE  &mt LSHFT INT4  &kp BSPC  &kp DEL  &kp LBKT  &kp LS(INT1)  &lt 6 PSCRN
