        combo_new_0 {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&mkp LCLK>;
        };
        combo_new_1 {
            timeout-ms = <50>;
            key-positions = <14 24>;
            bindings = <&mkp RCLK>;
        };
