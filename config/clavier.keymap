            >;
        };

        mouse_layer {
            bindings = <
                &kp F2  &kp F4  &kp F5  &kp LG(DOWN)  &kp LG(UP)  &trans  &kp HOME  &kp UP  &kp END  &trans  &trans  &trans  &kp LC(A)  &kp F8  &kp LCTRL  &kp LS(LG(RIGHT))  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &kp LC(S)  &trans  &kp LC(V)  &kp LC(B)  &trans  &kp PG_UP  &trans  &kp PG_DN  &trans  &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &trans  &trans  &kp LSHFT  &trans  &trans  &trans  &trans  &trans
            >;
